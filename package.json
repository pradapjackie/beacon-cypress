{
  "name": "beacon-cypress",
  "version": "0.3.0",
  "description": "Beacon HTML reports for Cypress.",
  "keywords": [
    "cypress",
    "reporter",
    "html",
    "beacon"
  ],
  "bin": {
    "beacon-cypress": "bin/beacon-cypress.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pradapjackie/beacon-cypress.git"
  },
  "homepage": "https://github.com/pradapjackie/beacon-cypress#readme",
  "bugs": {
    "url": "https://github.com/pradapjackie/beacon-cypress/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Pradap Pandiyan",
    "email": "pradapjackie@gmail.com",
    "url": "https://www.pradappandiyan.com"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./support": {
      "import": {
        "types": "./dist/support.d.ts",
        "default": "./dist/support.js"
      },
      "require": {
        "types": "./dist/support.d.cts",
        "default": "./dist/support.cjs"
      }
    }
  },
  "files": [
    "dist",
    "examples/cypress.config.js",
    "examples/package.json",
    "examples/cypress/e2e/smoke.cy.js",
    "examples/cypress/support/e2e.js",
    "bin/beacon-cypress.mjs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/copy-ui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "cypress": ">=13"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
